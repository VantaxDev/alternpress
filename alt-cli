function cli_files(): array {
    $files = [];
    $directory = new RecursiveDirectoryIterator(AP_ROOT, FilesystemIterator::SKIP_DOTS);
    $filter = new RecursiveCallbackFilterIterator($directory, static function(SplFileInfo $file): bool {
        $relative = str_replace('\\', '/', substr($file->getPathname(), strlen(AP_ROOT) + 1));
        // Prune excluded trees before visiting them, including large archives.
        if (preg_match('#^(?:\.git|cache|storage/(?:backups|restore))(?:/|$)|(?:^|/)(?:\.ap-|write\.lock|attempts\.php)#', $relative)) return false;
        if ($file->isLink()) throw new RuntimeException('A symlink prevents complete backup: ' . $relative);
        return true;
    });
    $iterator = new RecursiveIteratorIterator($filter);
    foreach ($iterator as $file) {
        $relative = substr($file->getPathname(), strlen(AP_ROOT) + 1);
        if (!$file->isFile() || $file->isLink() || preg_match('#^(?:\.git/|cache/|storage/(?:backups|restore)/)|(?:^|/)(?:\.ap-|write\.lock|attempts\.php)#', $relative)) continue;
        $files[$relative] = $file->getPathname();
    }
    ksort($files); return $files;
}
function cli_internal_link(string $url, string $source): ?bool {
    if ($url === '' || $url[0] === '#' || str_starts_with($url, 'mailto:') || str_starts_with($url, 'tel:')) return null;
    if (str_starts_with($url, '@media/')) return cli_local_file('media/' . rawurldecode(substr($url, 7)));
    $path = rawurldecode(parse_url($url, PHP_URL_PATH) ?? '');
    if ($path === '' || $path === '/') return true;
    if (!str_starts_with($path, '/')) return cli_local_file(substr(dirname($source), strlen(AP_ROOT) + 1) . '/' . $path);
    $base = (string) ap_config('base_path');
    if ($base !== '' && str_starts_with($path, $base . '/')) $path = substr($path, strlen($base));
    $path = rtrim($path, '/');
    // Discovery endpoints are generated by PHP, not backed by static files.
    // Match exact dispatcher routes after the same trailing-slash normalization.
    if (in_array($path, ['/sitemap.xml', '/llms.txt', '/robots.txt', '/knowledge-graph.jsonld'], true)) return true;
    if (preg_match('~\A/sitemap-([a-z]{2}(?:-[A-Za-z]{2,8})?)\.xml\z~D', $path, $match)
        && in_array($match[1], ap_discovery_languages(), true)) return true;
    foreach (SUPPORTED_LANGUAGES as $language) {
        if ($path === '/' . $language) return true;
        if (str_starts_with($path, '/' . $language . '/')) return route_content_exists(AP_ROOT . '/content', $language, substr($path, strlen($language) + 1));
    }
    if (in_array($path, ['/home', '/about', '/skills', '/archive', '/tags'], true)) return true;
    if (str_starts_with($path, '/post/') || str_starts_with($path, '/tag/')) return route_content_exists(AP_ROOT . '/content', DEFAULT_LANGUAGE, $path);
    return cli_local_file(ltrim($path, '/'));
}
function cli_local_file(string $relative): bool {
    if (preg_match('~[\\\\\x00-\x1f\x7f]~', $relative)) return false;
    $segments = [];
    foreach (explode('/', $relative) as $segment) {
        if ($segment === '' || $segment === '.') continue;
        if ($segment === '..') { if (!$segments) return false; array_pop($segments); }
        else $segments[] = $segment;
    }
    $path = AP_ROOT . '/' . implode('/', $segments);
    try { ap_backup_assert_path($path); } catch (RuntimeException) { return false; }
    return is_file($path);
}
function cli_public_ipv4(string $address): bool {
    if (!filter_var($address, FILTER_VALIDATE_IP, FILTER_FLAG_IPV4 | FILTER_FLAG_NO_PRIV_RANGE | FILTER_FLAG_NO_RES_RANGE)) return false;
    $number = ip2long($address);
    // Include shared address space, benchmarking and documentation ranges that
    // FILTER_FLAG_NO_RES_RANGE does not consistently reject across PHP versions.
    foreach (['0.0.0.0/8', '100.64.0.0/10', '192.0.0.0/24', '192.0.2.0/24', '198.18.0.0/15', '198.51.100.0/24', '203.0.113.0/24', '224.0.0.0/4', '240.0.0.0/4'] as $range) {
        [$network, $bits] = explode('/', $range);
        $mask = -1 << (32 - (int) $bits);
        if (($number & $mask) === (ip2long($network) & $mask)) return false;
    }
    return true;
}
function cli_external_parts(string $url): ?array {
    if (strlen($url) > 8192 || preg_match('~[\\\\\x00-\x20\x7f]~', $url) || !filter_var($url, FILTER_VALIDATE_URL)) return null;
    $parts = parse_url($url);
    if (!$parts || !in_array(strtolower($parts['scheme'] ?? ''), ['http', 'https'], true) || isset($parts['user']) || isset($parts['pass'])) return null;
    $parts['scheme'] = strtolower($parts['scheme']);
    $parts['host'] = strtolower($parts['host'] ?? '');
    if (!preg_match('/\A[a-z0-9](?:[a-z0-9.-]*[a-z0-9])?\z/D', $parts['host'])) return null;
    $parts['port'] ??= $parts['scheme'] === 'https' ? 443 : 80;
    // A Markdown link checker is not a general-purpose network scanner.
    if (!in_array($parts['port'], [80, 443], true)) return null;
    return $parts;
}
function cli_external_link(string $url): array {
    if (!function_exists('curl_init')) throw new RuntimeException('The optional --external check needs the PHP curl extension.');
    for ($hop = 0; $hop < 6; $hop++) {
        $parts = cli_external_parts($url);
        if (!$parts) return [0, 'unsupported URL (HTTP/HTTPS on ports 80/443 only)'];
        $host = $parts['host'];
        $addresses = gethostbynamel($host) ?: [];
        $public = array_values(array_filter($addresses, 'cli_public_ipv4'));
        if (!$public || count($public) !== count($addresses)) return [0, 'no public IPv4 address'];
        $port = $parts['port'];
        $redirect = null;
        $curl = curl_init($url);
        curl_setopt_array($curl, [CURLOPT_NOBODY => true, CURLOPT_RETURNTRANSFER => true, CURLOPT_FOLLOWLOCATION => false, CURLOPT_CONNECTTIMEOUT => 5, CURLOPT_TIMEOUT => 12, CURLOPT_USERAGENT => 'AlternPress link-checker', CURLOPT_PROXY => '', CURLOPT_IPRESOLVE => CURL_IPRESOLVE_V4, CURLOPT_RESOLVE => [$host . ':' . $port . ':' . $public[0]], CURLOPT_PROTOCOLS => CURLPROTO_HTTP | CURLPROTO_HTTPS, CURLOPT_HEADERFUNCTION => static function($handle, $line) use (&$redirect) { if (stripos($line, 'Location:') === 0) $redirect = trim(substr($line, 9)); return strlen($line); }]);
        curl_exec($curl); $status = (int) curl_getinfo($curl, CURLINFO_RESPONSE_CODE); $error = curl_error($curl); curl_close($curl);
        if ($status < 300 || $status >= 400 || !$redirect) return [$status, $error];
        if (str_starts_with($redirect, '//')) $redirect = $parts['scheme'] . ':' . $redirect;
        elseif (!preg_match('#^https?://#i', $redirect)) {
            $origin = $parts['scheme'] . '://' . $host . (isset($parts['port']) ? ':' . $port : '');
            $redirect = $origin . (str_starts_with($redirect, '/') ? $redirect : rtrim(dirname($parts['path'] ?? '/'), '/.') . '/' . $redirect);
        }
        $url = $redirect;
    }
    return [0, 'too many redirects'];
}

